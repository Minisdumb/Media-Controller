<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MusicController.SettingsWindow"
        Title="Music Controller Settings" 
        Width="380" Height="380"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        WindowDecorations="None" 
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    
    <Border Background="#1E1E1E" 
            CornerRadius="12" 
            BorderBrush="#333333" 
            BorderThickness="1" 
            Padding="20"
            ClipToBounds="True">

        <StackPanel VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="White"/>
            
            <StackPanel Orientation="Vertical" Spacing="10">
                <ToggleButton Name="ToggleAnim" Content="Toggle Animations" Click="ToggleAnim_Click" Padding="12,6"/>
                <ToggleButton Name="ToggleOverlayMode" Content="Rearrange/Drag Mode" Click="ToggleOverlayMode_Click" Padding="12,6"/>
                <Button Name="ResetPosition" Content="Reset Position" Click="ResetPosition_Click" Padding="6,4"/>
            </StackPanel>
            
            <TextBlock Text="Choose Modifiers (Optional):" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Name="ToggleCtrl" Content="CTRL" Click="Modifier_Click" Padding="12,6"/>
                <ToggleButton Name="ToggleAlt" Content="ALT" Click="Modifier_Click" Padding="12,6"/>
                <ToggleButton Name="ToggleShift" Content="SHIFT" Click="Modifier_Click" Padding="12,6"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="Trigger Key:" Foreground="White" VerticalAlignment="Center"/>
                <Button Name="BtnKeybind" Content="Space" Click="BtnKeybind_Click" Padding="12,6" Background="#292929" Foreground="#00FF7F"/>
            </StackPanel>
            
            <Grid Margin="0,10,0,0">
                <TextBlock Text="Hold combo to reveal widget." Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Padding="12,6"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
