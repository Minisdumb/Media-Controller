<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="MusicController.MainWindow"
        Title="Music Controller" 
        Width="400" Height="150" 
        CanResize="False" 
        Topmost="True" 
        WindowDecorations="None" 
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="0">
    
    <Border Background="#1E1E1E" 
            CornerRadius="12" 
            BorderBrush="#333333" 
            BorderThickness="1" 
            Padding="12"
            ClipToBounds="True">
        
        <Grid RowDefinitions="*, Auto, Auto" ColumnDefinitions="Auto, *, Auto">
            

            <Border Grid.Row="0" Grid.Column="0" Width="66" Height="66" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0" Background="#292929">
                <Image Name="ImgThumbnail" Stretch="UniformToFill"/>
            </Border>
            

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Name="TxtTitle" Text="No playback active" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="TxtArtist" Text="Unknown Artist" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button Click="BtnPrev_Click" Width="34" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent">
                    <ic:SymbolIcon Symbol="Previous" FontSize="16" Foreground="White"/>
                </Button>
                <Button Click="BtnPlayPause_Click" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#292929" CornerRadius="20">
                    <ic:SymbolIcon Name="IconPlayPause" Symbol="Play" FontSize="18" Foreground="White"/>
                </Button>
                <Button Click="BtnNext_Click" Width="34" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent">
                    <ic:SymbolIcon Symbol="Next" FontSize="16" Foreground="White"/>
                </Button>
            </StackPanel>

            <Slider Name="TimelineSlider" 
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                    Margin="0,8,0,0" Height="40"
                    Minimum="0" Maximum="100" Value="0"
                    Foreground="White"
                    IsHitTestVisible="False"/>

            
            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="2,0,2,0">
                <TextBlock Name="TxtCurrentTime" Text="0:00" FontSize="11" Foreground="Gray" DockPanel.Dock="Left"/>
                <TextBlock Name="TxtTotalTime" Text="0:00" FontSize="11" Foreground="Gray" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
            
        </Grid>
    </Border>
</Window>
